    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.56.0",
