# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Encrypts the wallet authentication cookie. Generate with: openssl rand -hex 32
# @type=string(minLength=32)
AUTH_SESSION_SECRET=

# Local Node development only. Cloudflare uses the DB binding to D1.
# @required=false @type=string
SQLITE_PATH=

# Public browser RPC endpoint; do not put a private API token here.
# @public @type=string
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional phone-reachable HTTPS origin for shared QR links.
# @public @required=false @type=string
VITE_PUBLIC_APP_URL=

# Optional: use hosted D1 from a Node dev server exposed through a tunnel.
# Leave all three unset to use local SQLite. Never prefix credentials with VITE_.
# @required=false @type=string
CLOUDFLARE_ACCOUNT_ID=
# @required=false @type=string
CLOUDFLARE_D1_DATABASE_ID=
# D1 Read + Write API token, kept on the server.
# @required=false @type=string
CLOUDFLARE_D1_TOKEN=
