# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Encrypts the wallet authentication cookie. Generate with: openssl rand -hex 32
# @type=string(minLength=32)
AUTH_SESSION_SECRET=

# Public Devnet program address. Leave unset until the voting program is deployed.
# @public @required=false @type=string
VITE_SOLANA_PROGRAM_ID=

# Public browser RPC endpoint; do not put a private API token here.
# @public @type=string
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional phone-reachable HTTPS origin for shared QR links.
# @public @required=false @type=string
VITE_PUBLIC_APP_URL=
